{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "playwright.live.config.ts",
    "pages/**/*.ts",
    "tests/**/*.ts"
  ]
}
